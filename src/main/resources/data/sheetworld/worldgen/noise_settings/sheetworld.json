                    "then_run": {"type": "minecraft:block", "result_state": {"Name": "minecraft:mycelium", "Properties": {"snowy": "false"}}}
                  },
                  {
                    "type": "minecraft:condition",
                    "if_true": {"type": "minecraft:biome", "biome_is": ["minecraft:snowy_plains", "minecraft:snowy_taiga", "minecraft:snowy_slopes", "minecraft:grove", "minecraft:ice_spikes"]},
                    "then_run": {
